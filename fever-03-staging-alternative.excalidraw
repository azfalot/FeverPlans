      "frameId": null,
      "roundness": null,
      "seed": 50294,
      "version": 1,
      "versionNonce": 50295,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Better when:\n- Provider requires all-or-nothing snapshots.\n- Need auditing, replay or reprocessing.\n- Need raw provider data after incidents.\n- Need validation before publication.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Better when:\n- Provider requires all-or-nothing snapshots.\n- Need auditing, replay or reprocessing.\n- Need raw provider data after incidents.\n- Need validation before publication.",
      "lineHeight": 1.25
    },
