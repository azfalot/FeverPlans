      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Implemented rules: online-only persistence, update existing plans, retain absent plans, offline snapshots do not overwrite last online version, skip malformed plan dates, deterministic UUID from (base_plan_id, provider_plan_id), schema.sql + Hibernate validate, indexes on starts_at and ends_at.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Implemented rules: online-only persistence, update existing plans, retain absent plans, offline snapshots do not overwrite last online version, skip malformed plan dates, deterministic UUID from (base_plan_id, provider_plan_id), schema.sql + Hibernate validate, indexes on starts_at and ends_at.",
